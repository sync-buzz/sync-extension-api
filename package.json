{
  "name": "@sync-buzz/extension-api",
  "version": "3.23.0",
  "description": "The contract an extension for Sync is written against, and the tools that hold it to it.",
  "license": "MIT",
  "homepage": "https://sync.buzz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sync-buzz/sync-extension-api.git"
  },
  "bugs": {
    "url": "https://github.com/sync-buzz/sync-extension-api/issues"
  },
  "keywords": [
    "sync",
    "extension",
    "extensions",
    "plugin",
    "sdk",
    "contract"
  ],
  "scripts": {
    "test": "node --test"
  },
  "type": "module",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts"
    },
    "./service": {
      "types": "./service/index.d.ts"
    },
    "./manifest.schema.json": "./schema/manifest.schema.json",
    "./runtime.json": "./runtime.json",
    "./theme.css": "./theme.css",
    "./theme": "./theme.css",
    "./extension.css": "./extension.css"
  },
  "bin": {
    "sync-ext": "./src/cli.mjs"
  },
  "files": [
    "types",
    "schema",
    "src",
    "runtime.json",
    "theme.css",
    "extension.css",
    "README.md",
    "LICENSE",
    "service"
  ],
  "peerDependencies": {
    "@types/react": "^19",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "lucide-react": "^1",
    "radix-ui": "^1",
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "ajv": "^8.17.1",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3"
  },
  "packageManager": "pnpm@11.18.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
